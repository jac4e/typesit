        "type": "string",
        "enum": [
          "food",
          "drinks",
          "clothing",
          "merch",
          "other"
        ],
        "description": "Enumeration of product categories for organizational purposes.\n\nCategories help organize products into logical groups for easier browsing,\ninventory management, and reporting. Each product must belong to exactly\none category.",
        "x-typia-jsDocTags": [
