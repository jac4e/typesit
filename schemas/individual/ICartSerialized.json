              {
                "text": "```typescript\nconst product: IProduct = {\n  // ...other properties\n  category: ProductCategories.Food,\n};\n\n// Filtering products by category\nconst foodProducts = products.filter(p => p.category === ProductCategories.Food);\n```",
                "kind": "text"
              }
            ]
          }
        ]
      },
      "ProductTypes": {
        "type": "string",
        "enum": [
          "stock",
          "order"
        ],
        "description": "Enumeration defining the two fundamental product management strategies.\n\nThis enum determines how a product is handled in the inventory and ordering system.\nThe choice affects which additional properties are required and how the product\nlifecycle is managed.",
        "x-typia-jsDocTags": [
          {
            "name": "enum",
            "text": [
              {
                "text": "*",
                "kind": "text"
              }
            ]
          },
          {
            "name": "example",
            "text": [
              {
                "text": "```typescript\n// Stock product - kept in inventory\nconst energyDrink: IProduct<ProductTypes.Stock> = {\n  type: ProductTypes.Stock,\n  stock: 150n, // 150 units in stock\n  // ...other properties\n};\n\n// Order product - ordered from supplier\nconst customTShirt: IProduct<ProductTypes.Order> = {\n  type: ProductTypes.Order,\n  order: {\n    supplier: 'T-Shirt Co',\n    minimum: 25n, // Minimum order of 25 shirts\n    current: 12n  // 12 pre-orders so far\n  },\n  // ...other properties\n};\n```",
                "kind": "text"
              }
            ]
          }
        ]
      },
      "TransactionType": {
        "type": "string",
        "enum": [
          "debit",
          "credit"
