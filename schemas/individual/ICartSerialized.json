        "description": "Transforms an interface for HTTP transmission by converting BigInt and Date types to strings.\nThis type utility ensures all BigInt values become string representations and all Date\nobjects become ISO string representations, making the data JSON-serializable for HTTP APIs.",
        "x-typia-jsDocTags": [
          {
            "name": "template",
            "text": [
              {
                "text": "T",
                "kind": "typeParameterName"
              },
              {
                "text": " ",
                "kind": "space"
              },
              {
                "text": "The interface type to transform for HTTP transmission",
                "kind": "text"
              }
            ]
          },
          {
            "name": "example",
            "text": [
              {
                "text": "```typescript\ninterface MyData {\n  id: string;\n  amount: bigint;\n  createdAt: Date;\n  count?: bigint;\n}\n\nconst httpData: HTTP<MyData> = {\n  id: \"123\",\n  amount: \"1000\",     // bigint → string\n  createdAt: \"2023-01-01T00:00:00.000Z\", // Date → string\n  count: \"5\"          // optional bigint → optional string\n};\n```",
                "kind": "text"
              }
            ]
          }
        ]
