            "text": [
              {
                "text": "```typescript\n// Creating a new pre-order\nconst newPreOrder: IPreOrder = {\n  // ...other properties\n  status: PreOrderStatus.Ordered\n};\n\n// Checking order status\nif (preOrder.status === PreOrderStatus.Fulfilled) {\n  console.log('Order has been completed and shipped');\n}\n```",
                "kind": "text"
              }
            ]
          }
        ]
      },
      "StockEntryType": {
        "type": "string",
        "enum": [
          "purchase",
          "shrinkage",
          "overage",
          "sale"
        ],
        "description": "Enumeration of all possible stock entry types.\n\nThis enum defines the different reasons why stock levels might change,\neach with specific business logic and required properties. The enum values\nare used as discriminator properties in the type system to ensure type safety.",
        "x-typia-jsDocTags": [
          {
            "name": "enum",
            "text": [
              {
                "text": "*",
                "kind": "text"
              }
            ]
          },
          {
            "name": "example",
            "text": [
              {
                "text": "```typescript\n// Using enum values for type discrimination\nconst createStockEntry = (type: StockEntryType, data: any) => {\n  switch (type) {\n    case StockEntryType.Purchase:\n      // TypeScript knows 'cost' property is required\n      return { ...data, cost: data.cost };\n    case StockEntryType.Sale:\n      // No additional properties required\n      return data;\n    // ... other cases\n  }\n};\n\n// Type-safe entry creation\nconst entry = createStockEntry(StockEntryType.Purchase, {\n  delta: 100n,\n  cost: 500n // Required for purchases\n});\n```",
                "kind": "text"
              }
            ]
          }
        ]
